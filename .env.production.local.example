# Private override loaded only when ARGIN_DB_TARGET=production in .env.dev.local.
# Copy to .env.production.local, chmod 600. Never commit credentials.
ConnectionStrings__ArginTaxPayerDb='Host=127.0.0.1;Port=15434;Database=argintaxpayer_prod;Username=argin_prod_app;Password=PRIVATE;SSL Mode=VerifyFull;Root Certificate=/private/path/prod-db-ca.pem'
PGSSLMODE=verify-full
PGSSLROOTCERT=/private/path/prod-db-ca.pem
Identity__OtpPepper='EXISTING_PRODUCTION_VALUE'
Identity__MfaEncryptionKey='EXISTING_PRODUCTION_VALUE'
SigningKeyProtection__DatabaseMasterKey='EXISTING_PRODUCTION_VALUE'
# Same Production identity/custody configuration as deployment is required.
# This launcher never runs migrations. Stop existing local processes before switching.

SigningKeyProtection__Provider=Database
SigningKeyProtection__Enabled=true
