# Reference only: .NET does not automatically load .env files.
# Export through your shell/process manager; NEVER commit production secrets.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ArginTaxPayer__DeploymentLabel=development
# In Production set PublicBaseUrl to a real HTTPS origin:
# ArginTaxPayer__PublicBaseUrl=https://taxpayer.example.com

# Optional in Development/Test; required in Production.
# Export this securely rather than committing actual credentials.
# ConnectionStrings__ArginTaxPayerDb="Host=localhost;Port=5432;Database=argintaxpayer_dev;Username=argintaxpayer;Password=YOUR_LOCAL_PASSWORD;SSL Mode=Prefer"

# Local Docker PostgreSQL startup (set only in your shell):
# export ARGIN_POSTGRES_PASSWORD='CHOOSE_A_STRONG_LOCAL_PASSWORD'

# Phase 03 Step 09: phone-first identity and opt-in Ghasedak OTP.
# Configure in SAME API process shell; .NET does not load this file automatically.
# Set Identity__OtpPepper to at least 32 random secret characters, never commit it.
# Identity__OtpPepper='REPLACE_WITH_PRIVATE_RANDOM_SECRET'
Ghasedak__TemplateName=TaxPayerActivationCode
Ghasedak__EnableLiveSending=false
# Ghasedak__ApiKey='PLACE_PRIVATE_KEY_IN_UNTRACKED_.env.ghasedak.local'
# DO NOT enable live sends until template, test recipient, costs and provider credentials are verified.
