[Unit]
Description=ArginTaxPayer Production API (Phase18 gated)
Documentation=https://github.com/HekmatBeigverdi/ArginTaxPayer
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3
# No activation in Step06. Requires explicit separate future owner-approved gate.
ConditionPathExists=/etc/argintaxpayer/phase18-activation-approved

[Service]
Type=simple
User=argintaxsvc
Group=argintaxsvc
WorkingDirectory=/opt/argintaxpayer/current/api
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:15090
Environment=ArginTaxPayer__EnableOperationalEndpoints=false
Environment=Ghasedak__EnableLiveSending=false
Environment=SandboxInvoiceLegacy__Enabled=false
Environment=SandboxInvoiceLegacy__OperatorApprovedEndpoint=false
Environment=Phase11__EnableReadOnlyQueueObserver=false
EnvironmentFile=-/etc/argintaxpayer/api.env
ExecStart=/usr/bin/env dotnet /opt/argintaxpayer/current/api/ArginTaxPayer.Api.dll
Restart=on-failure
RestartSec=10s
TimeoutStartSec=60s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RuntimeDirectory=argintaxpayer-api
StateDirectory=argintaxpayer
StandardOutput=journal
StandardError=journal
SyslogIdentifier=argintaxpayer-api

[Install]
WantedBy=multi-user.target
