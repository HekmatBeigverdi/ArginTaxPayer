# Copy to .env.dev.local (gitignored), chmod 600; never commit passwords.
# This connection is ONLY for local Phase testing over the AutoSSH tunnel.
# ConnectionStrings__ArginTaxPayerDb='Host=127.0.0.1;Port=15432;Database=argintaxpayer_test;Username=argintaxpayer;Password=YOUR_PRIVATE_TEST_DB_PASSWORD;SSL Mode=Prefer'
# Identity:MFA encryption key (if your account requires MFA), set securely:
# Identity__MfaEncryptionKey='YOUR_STABLE_PRIVATE_BASE64_KEY'
# Add further per-phase local Development settings below.
# Do NOT put Ghasedak keys here; use .env.ghasedak.local (also ignored).
ConnectionStrings__ArginTaxPayerDb='Host=127.0.0.1;Port=15432;Database=argintaxpayer_test;Username=argintaxpayer;Password=YOUR_PRIVATE_TEST_PASSWORD;SSL Mode=Prefer'
# Phase 09 — enable ONLY after test Vault Transit and KV v2 are configured and reachable.
# These flags are independent: Import unlocks the existing-key text form;
# Generation unlocks the new key ZIP flow; ConnectionTest uses either key.
# SigningKeyProtection__Enabled=true
# SigningKeyImport__Enabled=true
# SigningKeyGeneration__Enabled=true
# SigningConnectionTest__Enabled=true
# See docs/phases/phase-09.md for Vault address/mount/token-file options.
# Never add private PEM, raw Vault token or access token to this file.
